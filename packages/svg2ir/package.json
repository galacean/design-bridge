{
  "name": "@galacean/svg2ir",
  "version": "1.0.0",
  "description": "SVG to Animation IR and Galacean Effects conversion engine",
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.mjs",
        "require": "./dist/node.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm build:declaration && pnpm build:module",
    "build:module": "rollup -c --bundleConfigAsCjs",
    "build:declaration": "tsc -b ../animation-ir ../ge-ir tsconfig.json --emitDeclarationOnly",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@galacean/effects-specification": "catalog:",
    "@svgdotjs/svg.js": "3.2.7",
    "@galacean/animation-ir": "workspace:*",
    "@galacean/ge-ir": "workspace:*",
    "svgdom": "0.1.14"
  },
  "contributors": [
    {
      "name": "鳞息"
    }
  ],
  "author": "Ant Group CO., Ltd.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": "https://github.com/galacean/design-bridge",
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge/tree/main/packages/svg2ir#readme",
  "keywords": [
    "svg",
    "animation",
    "animation-ir",
    "galacean-effects",
    "converter"
  ]
}
