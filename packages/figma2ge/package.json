{
  "name": "@galacean/figma2ge",
  "private": true,
  "version": "0.0.1-beta.11",
  "description": "Figma to Galacean Effects conversion engine",
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm build:declaration && pnpm build:module",
    "build:module": "rollup -c --bundleConfigAsCjs",
    "build:declaration": "tsc -d --emitDeclarationOnly",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "fzstd": "0.1.1",
    "kiwi-schema": "catalog:",
    "pako": "catalog:"
  },
  "peerDependencies": {
    "@galacean/effects": "catalog:"
  },
  "contributors": [
    {
      "name": "意绮"
    }
  ],
  "author": "Ant Group CO., Ltd.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": "https://github.com/galacean/design-bridge",
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge/tree/main/packages/figma2ge#readme",
  "keywords": [
    "figma",
    "galacean-effects",
    "jsonscene",
    "converter"
  ]
}
