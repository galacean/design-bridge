{
  "name": "@galacean/animation-ir",
  "version": "1.0.0",
  "description": "Shared animation IR schema, adapter contracts, and validator",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js",
      "default": "./dist/adapter/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js",
      "default": "./dist/validator/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "pnpm test:unit && pnpm test:types",
    "test:unit": "vitest run",
    "test:types": "tsc -p tests/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "contributors": [
    {
      "name": "澄弈"
    }
  ],
  "author": "Ant Group CO., Ltd.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": "https://github.com/galacean/design-bridge",
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge/tree/main/packages/animation-ir#readme",
  "keywords": [
    "animation",
    "animation-ir",
    "schema",
    "validation"
  ]
}
