{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src"
  ]
}
