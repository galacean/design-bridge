{
  "name": "@galacean/shader2ge",
  "version": "1.0.0",
  "description": "Shader to Galacean Effects conversion engine",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm build:declaration && pnpm build:module",
    "build:module": "rollup -c --bundleConfigAsCjs",
    "build:declaration": "tsc -d --emitDeclarationOnly",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@galacean/effects-specification": "catalog:",
    "uuid": "catalog:"
  },
  "contributors": [
    {
      "name": "陈茉"
    }
  ],
  "author": "Ant Group CO., Ltd.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": "https://github.com/galacean/design-bridge",
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge/tree/main/packages/shader2ge#readme",
  "keywords": [
    "glsl",
    "webgl",
    "galacean-effects",
    "jsonscene",
    "shader"
  ]
}
