{
  "name": "@galacean/dsl-ir",
  "version": "1.0.0",
  "description": "Editable DSL and Animation IR bidirectional converter",
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm build:declaration && pnpm build:module",
    "build:module": "rollup -c --bundleConfigAsCjs",
    "build:declaration": "tsc -b ../animation-ir tsconfig.json --emitDeclarationOnly",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@galacean/animation-ir": "workspace:*",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@galacean/effects-specification": "catalog:",
    "@galacean/ge-ir": "workspace:*"
  },
  "contributors": [
    {
      "name": "澄弈"
    }
  ],
  "author": "Ant Group CO., Ltd.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": "https://github.com/galacean/design-bridge",
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge/tree/main/packages/dsl-ir#readme",
  "keywords": [
    "animation",
    "animation-ir",
    "dsl",
    "converter"
  ]
}
