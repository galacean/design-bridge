{
  "name": "monorepo-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web-packages dev",
    "dev:site": "pnpm --filter site dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "lint": "eslint --ext .ts,.tsx .",
    "lint:fix": "eslint --fix --ext .ts,.tsx .",
    "test": "pnpm -r test",
    "check:ts": "tsc -b ./tsconfig.check.json",
    "clean:nm": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "clean:dist": "pnpm -r --include-workspace-root exec rimraf dist",
    "clean:artifacts": "pnpm -r --include-workspace-root exec rimraf --glob \"src/**/*.js.map\"",
    "clean:declaration": "pnpm -r --include-workspace-root exec rimraf --glob \"*.tsbuildinfo\"",
    "clean:all": "pnpm clean:artifacts && pnpm clean:declaration && pnpm clean:dist && pnpm clean:nm",
    "preinstall": "only-allow pnpm",
    "postinstall": "make sync-skills",
    "prepare": "husky install",
    "publish": "pnpm -r publish",
    "publish:alpha": "pnpm -r publish --tag alpha --no-git-checks",
    "publish:beta": "pnpm -r publish --tag beta --no-git-checks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@galacean/effects": "catalog:",
    "@galacean/docs-tools": "^0.0.12",
    "@galacean/eslint-config": "^0.0.12",
    "@galacean/release-tools": "^0.0.12",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-wasm": "^6.2.2",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/pako": "^2.0.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "only-allow": "^1.2.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.8",
    "rollup-plugin-swc3": "^0.12.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galacean/design-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/galacean/design-bridge/issues"
  },
  "homepage": "https://github.com/galacean/design-bridge#readme",
  "keywords": [
    "animation",
    "design",
    "figma",
    "galacean-effects",
    "lottie",
    "svg"
  ]
}
